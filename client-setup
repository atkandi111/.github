#!/usr/bin/env bash
set -euo pipefail

platform_root=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
template_root="$platform_root/templates/client"

client_files=(
  AGENTS.md
  PROJECT.md
  .github/workflows/agent.yml
  .github/workflows/ci.yml
  .github/workflows/governance.yml
)

account_default_overrides=(
  .github/ISSUE_TEMPLATE
  .github/pull_request_template.md
  PULL_REQUEST_TEMPLATE.md
  docs/pull_request_template.md
)

usage() {
  printf '%s\n' \
    'usage:' \
    '  ./client-setup onboard TARGET PLATFORM_OWNER/REPOSITORY CLIENT_OWNER/REPOSITORY' \
    '  ./client-setup install TARGET OWNER/REPOSITORY' \
    '  ./client-setup check TARGET' \
    '  ./client-setup install-canary TARGET OWNER/REPOSITORY COMMIT_SHA' \
    '  ./client-setup check-canary TARGET' \
    '  ./client-setup labels CLIENT_OWNER/REPOSITORY'
}

require_portfolio_registration() {
  local repository=$1 inventory=$platform_root/config/portfolio-repositories.txt
  [[ $repository =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || {
    echo 'invalid client repository: expected OWNER/REPOSITORY' >&2
    return 64
  }
  grep -Fqx "$repository" "$inventory" || {
    echo "client repository is not registered for Portfolio reconciliation: $repository" >&2
    echo 'Add it to config/portfolio-repositories.txt through a reviewed account .github change first.' >&2
    return 1
  }
}

onboard_client() {
  [[ $# -eq 3 ]] || { usage >&2; return 64; }
  local target=$1 platform_repository=$2 client_repository=$3
  require_portfolio_registration "$client_repository"
  install_client main "$target" "$platform_repository"
  printf '%s\n' \
    'Portfolio onboarding remains:' \
    "1. Run: $platform_root/client-setup labels $client_repository" \
    '2. Configure the publisher App, the dedicated OpenAI key, and disabled-by-default variables.' \
    '3. Run the Portfolio membership audit workflow.'
}

configure_labels() {
  [[ $# -eq 1 ]] || { usage >&2; return 64; }
  local repository=$1
  [[ $repository =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || {
    echo 'invalid client repository: expected OWNER/REPOSITORY' >&2
    return 64
  }
  command -v gh >/dev/null || { echo 'GitHub CLI is required' >&2; return 1; }
  gh label create implementation --repo "$repository" --color 1d76db \
    --description 'Owner-created reviewed work queued for implementation' --force
  gh label create planning --repo "$repository" --color d4c5f9 \
    --description 'Planning, deferred, backlogged, or coordination-only work' --force
  gh label create agent:authorized --repo "$repository" --color 0e8a16 \
    --description 'Trusted receipt from the owner-authored Issue opened event' --force
}

absolute_directory() {
  local directory=$1
  [[ -d $directory ]] || { echo "directory not found: $directory" >&2; return 1; }
  (cd "$directory" && pwd -P)
}

validate_destination_parent() {
  local target=$1 relative=$2 parent current part
  local -a parts
  parent=$(dirname "$relative")
  [[ $parent == . ]] && return 0
  current=$target
  IFS=/ read -r -a parts <<< "$parent"
  for part in "${parts[@]}"; do
    current="$current/$part"
    [[ ! -L $current ]] || { echo "refusing symlinked destination directory: $current" >&2; return 1; }
    [[ ! -e $current || -d $current ]] || { echo "destination parent is not a directory: $current" >&2; return 1; }
  done
}

install_client() {
  local mode=$1
  shift
  local expected=2
  [[ $mode == canary ]] && expected=3
  [[ $# -eq $expected ]] || { usage >&2; return 64; }

  local target repository version=main check_command=check relative collision=false
  target=$(absolute_directory "$1")
  repository=$2
  [[ $repository =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || {
    echo 'invalid platform repository: expected OWNER/REPOSITORY' >&2
    return 64
  }
  if [[ $mode == canary ]]; then
    version=$3
    check_command=check-canary
    [[ $version =~ ^[0-9a-f]{40}$ ]] || { echo 'invalid canary version' >&2; return 64; }
  fi

  for relative in "${client_files[@]}"; do
    validate_destination_parent "$target" "$relative" || collision=true
    if [[ -e "$target/$relative" || -L "$target/$relative" ]]; then
      echo "refusing to overwrite: $target/$relative" >&2
      collision=true
    fi
  done
  [[ $collision == false ]] || { echo 'No files were installed. Merge existing files manually.' >&2; return 1; }

  for relative in "${client_files[@]}"; do
    mkdir -p "$(dirname "$target/$relative")"
    sed -e "s|YOUR_OWNER/.github|$repository|g" -e "s|@main|@$version|g" \
      -e "s|platform_ref: main|platform_ref: $version|g" \
      "$template_root/$relative" > "$target/$relative"
  done

  printf 'Installed %s client files in %s.\n\n' "${#client_files[@]}" "$target"
  printf '%s\n' \
    'Next:' \
    '1. Replace template guidance and tailor CI commands.' \
    "2. Run: $platform_root/client-setup $check_command \"$target\"" \
    '3. Configure the Issue pipeline from docs/cloud-setup.md.'
}

check_client() {
  local mode=$1
  shift
  [[ $# -eq 1 ]] || { usage >&2; return 64; }
  local target relative failed=false expected=@main
  target=$(absolute_directory "$1")
  [[ $mode == canary ]] && expected='@[0-9a-f]{40}'

  for relative in "${client_files[@]}"; do
    [[ -f "$target/$relative" ]] || { echo "missing: $relative" >&2; failed=true; }
  done
  [[ $failed == false ]] || return 1

  for relative in "${client_files[@]}"; do
    if grep -En 'YOUR_OWNER/\.github|YOUR_ORG/dev-platform' "$target/$relative"; then
      echo "obsolete or incomplete pipeline configuration found in $relative" >&2
      failed=true
    fi
  done
  if ! grep -Eq "/\.github/\.github/workflows/(ci|governance)\.yml${expected}" \
      "$target/.github/workflows/ci.yml" "$target/.github/workflows/governance.yml"; then
    echo "workflow callers do not use the expected release reference: $expected" >&2
    failed=true
  fi
  if ! grep -Eq "/\.github/\.github/workflows/agent\.yml${expected}" \
      "$target/.github/workflows/agent.yml"; then
    echo "agent workflow callers do not use the expected release reference: $expected" >&2
    failed=true
  fi
  if [[ $mode == canary ]]; then
    grep -Eq 'platform_ref: [0-9a-f]{40}' "$target/.github/workflows/agent.yml" || {
      echo 'agent canary does not pin its matching platform policy helpers' >&2
      failed=true
    }
  else
    grep -Fq 'platform_ref: main' "$target/.github/workflows/agent.yml" || {
      echo 'agent caller does not follow the platform main policy helpers' >&2
      failed=true
    }
  fi
  for relative in "${account_default_overrides[@]}"; do
    if [[ -e "$target/$relative" || -L "$target/$relative" ]]; then
      echo "local template overrides account defaults: $relative" >&2
      failed=true
    fi
  done
  if grep -Eq 'Replace this guidance|Document the important|document the command' "$target/PROJECT.md" "$target/AGENTS.md"; then
    echo 'repository guidance still contains template placeholders' >&2
    failed=true
  fi

  [[ $failed == false ]] || return 1
  printf '%s\n' \
    'Repository files are ready.' \
    '- Protect main and require deterministic CI.' \
    '- Verify the account-level Issue and pull-request templates in GitHub.' \
    '- Keep pull-request CI free of deployment credentials.' \
    '- Configure the Issue pipeline and native Codex review using docs/cloud-setup.md.' \
    '- Keep the portfolio Project for visibility, not authorization.'
}

case ${1:-} in
  onboard) shift; onboard_client "$@" ;;
  install) shift; install_client main "$@" ;;
  check) shift; check_client main "$@" ;;
  install-canary) shift; install_client canary "$@" ;;
  check-canary) shift; check_client canary "$@" ;;
  labels) shift; configure_labels "$@" ;;
  *) usage >&2; exit 64 ;;
esac
