#!/usr/bin/env bash
set -euo pipefail

platform_root=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
template_root="$platform_root/templates/client"

client_files=(
  AGENTS.md
  PROJECT.md
  .github/ISSUE_TEMPLATE/01-implementation.yml
  .github/ISSUE_TEMPLATE/02-planning.yml
  .github/ISSUE_TEMPLATE/config.yml
  .github/pull_request_template.md
  .github/workflows/ci.yml
  .github/workflows/governance.yml
)

usage() {
  printf '%s\n' \
    'usage:' \
    '  ./client-setup install TARGET OWNER/REPOSITORY' \
    '  ./client-setup check TARGET' \
    '  ./client-setup install-canary TARGET OWNER/REPOSITORY COMMIT_SHA' \
    '  ./client-setup check-canary TARGET'
}

absolute_directory() {
  local directory=$1
  [[ -d $directory ]] || { echo "directory not found: $directory" >&2; return 1; }
  (cd "$directory" && pwd -P)
}

validate_destination_parent() {
  local target=$1 relative=$2 parent current part
  local -a parts
  parent=$(dirname "$relative")
  [[ $parent == . ]] && return 0
  current=$target
  IFS=/ read -r -a parts <<< "$parent"
  for part in "${parts[@]}"; do
    current="$current/$part"
    [[ ! -L $current ]] || { echo "refusing symlinked destination directory: $current" >&2; return 1; }
    [[ ! -e $current || -d $current ]] || { echo "destination parent is not a directory: $current" >&2; return 1; }
  done
}

install_client() {
  local mode=$1
  shift
  local expected=2
  [[ $mode == canary ]] && expected=3
  [[ $# -eq $expected ]] || { usage >&2; return 64; }

  local target repository version=main check_command=check relative collision=false
  target=$(absolute_directory "$1")
  repository=$2
  [[ $repository =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || {
    echo 'invalid platform repository: expected OWNER/REPOSITORY' >&2
    return 64
  }
  if [[ $mode == canary ]]; then
    version=$3
    check_command=check-canary
    [[ $version =~ ^[0-9a-f]{40}$ ]] || { echo 'invalid canary version' >&2; return 64; }
  fi

  for relative in "${client_files[@]}"; do
    validate_destination_parent "$target" "$relative" || collision=true
    if [[ -e "$target/$relative" || -L "$target/$relative" ]]; then
      echo "refusing to overwrite: $target/$relative" >&2
      collision=true
    fi
  done
  [[ $collision == false ]] || { echo 'No files were installed. Merge existing files manually.' >&2; return 1; }

  for relative in "${client_files[@]}"; do
    mkdir -p "$(dirname "$target/$relative")"
    sed -e "s|YOUR_ORG/dev-platform|$repository|g" -e "s|@main|@$version|g" \
      "$template_root/$relative" > "$target/$relative"
  done

  printf 'Installed %s client files in %s.\n\n' "${#client_files[@]}" "$target"
  printf '%s\n' \
    'Next:' \
    '1. Replace template guidance and tailor CI commands.' \
    "2. Run: $platform_root/client-setup $check_command \"$target\"" \
    '3. Configure the repository Codex Cloud environment from docs/cloud-setup.md.'
}

check_client() {
  local mode=$1
  shift
  [[ $# -eq 1 ]] || { usage >&2; return 64; }
  local target relative failed=false expected=@main
  target=$(absolute_directory "$1")
  [[ $mode == canary ]] && expected='@[0-9a-f]{40}'

  for relative in "${client_files[@]}"; do
    [[ -f "$target/$relative" ]] || { echo "missing: $relative" >&2; failed=true; }
  done
  [[ $failed == false ]] || return 1

  if [[ -e "$target/.github/workflows/agent.yml" ]]; then
    echo 'obsolete custom agent workflow found' >&2
    failed=true
  fi
  for relative in "${client_files[@]}"; do
    if grep -En 'YOUR_ORG/dev-platform|OPENAI_API_KEY|AGENT_PIPELINE_ENABLED|PIPELINE_ENABLED' "$target/$relative"; then
      echo "obsolete or incomplete pipeline configuration found in $relative" >&2
      failed=true
    fi
  done
  if ! grep -Eq "dev-platform/.github/workflows/(ci|governance)\.yml${expected}" \
      "$target/.github/workflows/ci.yml" "$target/.github/workflows/governance.yml"; then
    echo "workflow callers do not use the expected release reference: $expected" >&2
    failed=true
  fi
  grep -Fq '@codex implement this issue' "$target/.github/ISSUE_TEMPLATE/01-implementation.yml" || {
    echo 'implementation Issue is missing its queue instruction' >&2
    failed=true
  }
  grep -Fq '## Merge Brief' "$target/.github/pull_request_template.md" || {
    echo 'pull request template is missing the Merge Brief' >&2
    failed=true
  }
  if grep -Eq 'Replace this guidance|Document the important|document the command' "$target/PROJECT.md" "$target/AGENTS.md"; then
    echo 'repository guidance still contains template placeholders' >&2
    failed=true
  fi

  [[ $failed == false ]] || return 1
  printf '%s\n' \
    'Repository files are ready.' \
    '- Protect main and require deterministic CI.' \
    '- Keep pull-request CI free of deployment credentials.' \
    '- Configure Codex Cloud using docs/cloud-setup.md.' \
    '- Keep the portfolio Project for visibility, not authorization.'
}

case ${1:-} in
  install) shift; install_client main "$@" ;;
  check) shift; check_client main "$@" ;;
  install-canary) shift; install_client canary "$@" ;;
  check-canary) shift; check_client canary "$@" ;;
  *) usage >&2; exit 64 ;;
esac
